#!/bin/bash
# UniversalLite OS - Live Build Auto Script
# Minimal working version for GitHub Actions

set -o pipefail

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --arch)
            ARCH="$2"
            shift 2
            ;;
        --distribution)
            DISTRIBUTION="$2"
            shift 2
            ;;
        --variant)
            VARIANT="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Environment variables as fallback
ARCH="${ARCH:-$(dpkg --print-architecture 2>/dev/null || echo amd64)}"
DISTRIBUTION="${DISTRIBUTION:-bookworm}"
VARIANT="${VARIANT:-balanced}"

export LB_BOOTSTRAP_INCLUDE="apt-transport-https ca-certificates curl gnupg"
export DEBIAN_FRONTEND=noninteractive

echo "=== UniversalLite OS Build ==="
echo "Architecture: $ARCH"
echo "Distribution: $DISTRIBUTION"
echo "Variant: $VARIANT"

# Map architecture
case "$ARCH" in
    amd64|x86_64) ARCHIVE="amd64" ;;
    arm64|aarch64) ARCHIVE="arm64" ;;
    armhf|arm) ARCHIVE="armhf" ;;
    *) ARCHIVE="$ARCH" ;;
esac

echo "Using archive: $ARCHIVE"

# Verify live-build
if ! command -v lb &> /dev/null; then
    echo "ERROR: lb command not found"
    exit 1
fi

echo "lb version: $(lb --version 2>/dev/null || echo 'unknown')"

# Clean previous build
lb clean --purge 2>/dev/null || true

# Configure live-build - MINIMAL options only
echo "Configuring live-build..."

lb config noauto \
    --architectures "$ARCHIVE" \
    --distribution "$DISTRIBUTION" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --mode debian || {
        echo "ERROR: lb config failed"
        exit 1
    }

echo "=== Configuration complete ==="
