#!/bin/bash
# UniversalLite OS - Live Build Auto Script
# Docker-compatible version for Debian containers

set -e

# Parse command line arguments
ARCH="amd64"
DISTRIBUTION="bookworm"
VARIANT="balanced"

while [[ $# -gt 0 ]]; do
    case $1 in
        --arch) ARCH="$2"; shift 2 ;;
        --distribution) DISTRIBUTION="$2"; shift 2 ;;
        --variant) VARIANT="$2"; shift 2 ;;
        *) shift ;;
    esac
done

# Environment variables as fallback
ARCH="${ARCH:-amd64}"
DISTRIBUTION="${DISTRIBUTION:-bookworm}"
VARIANT="${VARIANT:-balanced}"

export DEBIAN_FRONTEND=noninteractive

echo "=== UniversalLite OS Build ==="
echo "Architecture: $ARCH"
echo "Distribution: $DISTRIBUTION"
echo "Variant: $VARIANT"

# Map architecture
case "$ARCH" in
    amd64|x86_64) ARCHIVE="amd64" ;;
    arm64|aarch64) ARCHIVE="arm64" ;;
    armhf|arm) ARCHIVE="armhf" ;;
    *) ARCHIVE="$ARCH" ;;
esac

echo "Using archive: $ARCHIVE"

# Clean previous build
lb clean --purge 2>/dev/null || true

# Configure live-build with explicit Debian mirrors
echo "Configuring live-build..."

lb config noauto \
    --architectures "$ARCHIVE" \
    --distribution "$DISTRIBUTION" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --mode debian \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-debian-installer "http://deb.debian.org/debian/" \
    --bootappend-live "boot=live components username=universalite hostname=universalite noapic"

echo "=== Configuration complete ==="