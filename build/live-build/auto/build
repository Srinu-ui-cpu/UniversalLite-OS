#!/bin/bash
# UniversalLite OS - Live Build Auto Script
# Simplified version for GitHub Actions

set -o pipefail

# Configuration - accept command line args or use environment variables
# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --arch)
            ARCH="$2"
            shift 2
            ;;
        --distribution)
            DISTRIBUTION="$2"
            shift 2
            ;;
        --variant)
            VARIANT="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Environment variables as fallback
ARCH="${ARCH:-$(dpkg --print-architecture 2>/dev/null || echo amd64)}"
DISTRIBUTION="${DISTRIBUTION:-trixie}"
VARIANT="${VARIANT:-balanced}"

# Configuration
export LB_BOOTSTRAP_INCLUDE="apt-transport-https ca-certificates curl gnupg"
export DEBIAN_FRONTEND=noninteractive

echo "=== UniversalLite OS Build ==="
echo "Architecture: $ARCH"
echo "Distribution: $DISTRIBUTION"
echo "Variant: $VARIANT"

# Map architecture to correct names
case "$ARCH" in
    amd64|x86_64)
        ARCHIVE="amd64"
        KERNEL_PKG="linux-image-amd64"
        ;;
    arm64|aarch64)
        ARCHIVE="arm64"
        KERNEL_PKG="linux-image-arm64"
        ;;
    armhf|arm)
        ARCHIVE="armhf"
        KERNEL_PKG="linux-image-armmp"
        ;;
    *)
        ARCHIVE="$ARCH"
        KERNEL_PKG="linux-image-${ARCH}"
        ;;
esac

echo "Using archive: $ARCHIVE, kernel: $KERNEL_PKG"

# Verify live-build is installed
if ! command -v lb &> /dev/null; then
    echo "ERROR: lb command not found - live-build may not be installed"
    exit 1
fi

echo "lb version: $(lb --version 2>/dev/null || echo 'unknown')"

# Clean previous build
lb clean --purge 2>/dev/null || true

# Configure live-build with simplified options
echo "Configuring live-build..."

# Test each option individually
echo "Testing --architectures..."
lb config noauto --architectures "$ARCHIVE" || { echo "ERROR: --architectures failed"; exit 1; }

echo "Testing --distribution..."
lb config noauto --distribution "$DISTRIBUTION" || { echo "ERROR: --distribution failed"; exit 1; }

echo "Testing --archive-areas..."
lb config noauto --archive-areas "main contrib non-free non-free-firmware" || { echo "ERROR: --archive-areas failed"; exit 1; }

echo "Testing --binary-filesystem..."
lb config noauto --binary-filesystem ext4 || { echo "ERROR: --binary-filesystem failed"; exit 1; }

echo "Testing --binary-images..."
lb config noauto --binary-images iso-hybrid || { echo "ERROR: --binary-images failed"; exit 1; }

echo "Testing --bootappend-live..."
lb config noauto --bootappend-live "boot=live quiet splash" || { echo "ERROR: --bootappend-live failed"; exit 1; }

echo "Testing --chroot-filesystem..."
lb config noauto --chroot-filesystem ext4 || { echo "ERROR: --chroot-filesystem failed"; exit 1; }

echo "Testing --compression..."
lb config noauto --compression gzip || { echo "ERROR: --compression failed"; exit 1; }

echo "Testing --debootstrap-options..."
lb config noauto --debootstrap-options "--variant=minbase" || { echo "ERROR: --debootstrap-options failed"; exit 1; }

echo "Testing --iso-application..."
lb config noauto --iso-application "UniversalLite OS" || { echo "ERROR: --iso-application failed"; exit 1; }

echo "Testing --iso-volume..."
lb config noauto --iso-volume "UniversalLite" || { echo "ERROR: --iso-volume failed"; exit 1; }

echo "Testing --mode..."
lb config noauto --mode debian || { echo "ERROR: --mode failed"; exit 1; }

echo "=== Configuration complete ==="
