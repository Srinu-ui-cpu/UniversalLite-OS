#!/bin/bash
# UniversalLite OS - Live Build Auto Script
# Simplified version for GitHub Actions

set -o pipefail

# Configuration
export LB_BOOTSTRAP_INCLUDE="apt-transport-https ca-certificates curl gnupg"
export DEBIAN_FRONTEND=noninteractive

# Architecture detection
ARCH="${ARCH:-$(dpkg --print-architecture)}"
DISTRIBUTION="${DISTRIBUTION:-trixie}"
VARIANT="${VARIANT:-balanced}"

echo "=== UniversalLite OS Build ==="
echo "Architecture: $ARCH"
echo "Distribution: $DISTRIBUTION"
echo "Variant: $VARIANT"

# Map architecture to correct names
case "$ARCH" in
    amd64)
        ARCHIVE="amd64"
        KERNEL_PKG="linux-image-amd64"
        ;;
    arm64)
        ARCHIVE="arm64"
        KERNEL_PKG="linux-image-arm64"
        ;;
    armhf)
        ARCHIVE="armhf"
        KERNEL_PKG="linux-image-armmp"
        ;;
    *)
        ARCHIVE="$ARCH"
        KERNEL_PKG="linux-image-${ARCH}"
        ;;
esac

echo "Using archive: $ARCHIVE, kernel: $KERNEL_PKG"

# Clean previous build
lb clean --purge 2>/dev/null || true

# Configure live-build with simplified options
echo "Configuring live-build..."

lb config noauto \
    --architectures "$ARCHIVE" \
    --distribution "$DISTRIBUTION" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-indices false \
    --apt-recommends false \
    --binary-filesystem ext4 \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live quiet splash" \
    --bootloader "grub-efi,syslinux" \
    --chroot-filesystem ext4 \
    --compression gzip \
    --debootstrap-options "--variant=minbase" \
    --firmware-binary true \
    --firmware-chroot true \
    --iso-application "UniversalLite OS" \
    --iso-volume "UniversalLite" \
    --mode debian \
    --security true \
    --source false \
    --system normal \
    --variant "$VARIANT" \
    "${@}" || {
        echo "ERROR: lb config failed"
        exit 1
    }

echo "=== Configuration complete ==="