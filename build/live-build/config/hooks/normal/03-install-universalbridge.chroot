#!/bin/bash
# Hook: 03-install-universalbridge
# Install Wine, Box86/Box64, DXVK/VKD3D, and UniversalBridge daemon

set -euo pipefail

echo "=== Installing UniversalBridge (Windows Compatibility) ==="

# Add WineHQ Repository
mkdir -p /etc/apt/keyrings
wget -qO- https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq.gpg
echo "deb [signed-by=/etc/apt/keyrings/winehq.gpg] https://dl.winehq.org/wine-builds/debian/ trixie main" > /etc/apt/sources.list.d/winehq.list

# Add Box86/Box64 Repositories (ARM64/ARMhf only)
if [[ "$LB_ARCHITECTURES" == "arm64" || "$LB_ARCHITECTURES" == "armhf" ]]; then
    wget -qO- https://ryanfortner.github.io/box64-debs/arm64/KEY.gpg | gpg --dearmor -o /etc/apt/keyrings/box64.gpg
    echo "deb [signed-by=/etc/apt/keyrings/box64.gpg arch=arm64] https://ryanfortner.github.io/box64-debs/arm64 ./" > /etc/apt/sources.list.d/box64.list
    
    wget -qO- https://ryanfortner.github.io/box86-debs/arm64/KEY.gpg | gpg --dearmor -o /etc/apt/keyrings/box86.gpg
    echo "deb [signed-by=/etc/apt/keyrings/box86.gpg arch=arm64] https://ryanfortner.github.io/box86-debs/arm64 ./" > /etc/apt/sources.list.d/box86.list
fi

# Add DXVK/VKD3D Repository
wget -qO- https://repo.steampowered.com/steam/archive/stable/steam.gpg | gpg --dearmor -o /etc/apt/keyrings/steam.gpg
echo "deb [signed-by=/etc/apt/keyrings/steam.gpg] https://repo.steampowered.com/steam/archive/stable/ trixie main" > /etc/apt/sources.list.d/steam.list

# Update and install
apt-get update

# Core Wine packages
apt-get install -y --no-install-recommends \
    winehq-stable \
    wine \
    wine64 \
    wine32 \
    wine-binfmt \
    libwine \
    libwine:i386 \
    fonts-wine \
    wine-mono \
    wine-gecko \
    winetricks

# DXVK & VKD3D
apt-get install -y --no-install-recommends \
    dxvk \
    vkd3d \
    vkd3d-proton \
    libvkd3d1 \
    libvkd3d1:i386 \
    libdxvk1 \
    libdxvk1:i386

# Box86/Box64 (ARM only)
if [[ "$LB_ARCHITECTURES" == "arm64" || "$LB_ARCHITECTURES" == "armhf" ]]; then
    apt-get install -y --no-install-recommends \
        box86 \
        box64
    
    # Register binfmt for Box86/Box64
    update-binfmts --enable box86 2>/dev/null || true
    update-binfmts --enable box64 2>/dev/null || true
fi

# 32-bit libraries for Wine/Box86
if [[ "$LB_ARCHITECTURES" == "amd64" ]]; then
    dpkg --add-architecture i386
    apt-get update
    apt-get install -y --no-install-recommends \
        libc6:i386 \
        libstdc++6:i386 \
        libgcc-s1:i386 \
        libglib2.0-0:i386 \
        libpng16-16:i386 \
        libfreetype6:i386 \
        libasound2:i386 \
        libpulse0:i386 \
        libx11-6:i386 \
        libxext6:i386 \
        libxi6:i386 \
        libxrandr2:i386 \
        libxrender1:i386 \
        libxxf86vm1:i386 \
        libdrm2:i386 \
        libvulkan1:i386 \
        libvkd3d1:i386 \
        libdxvk1:i386 \
        mesa-vulkan-drivers:i386
elif [[ "$LB_ARCHITECTURES" == "arm64" ]]; then
    dpkg --add-architecture armhf
    apt-get update
    apt-get install -y --no-install-recommends \
        libc6:armhf \
        libstdc++6:armhf \
        libgcc-s1:armhf \
        libglib2.0-0:armhf \
        libpng16-16:armhf \
        libfreetype6:armhf \
        libasound2:armhf \
        libpulse0:armhf \
        libx11-6:armhf \
        libxext6:armhf \
        libxi6:armhf \
        libxrandr2:armhf \
        libxrender1:armhf \
        libxxf86vm1:armhf \
        libdrm2:armhf \
        libvulkan1:armhf \
        mesa-vulkan-drivers:armhf
fi

# Create UniversalBridge directories
mkdir -p /usr/share/universalbridge/{prefixes,logs,runtimes,compatdb}
mkdir -p /etc/universalbridge

# UniversalBridge Daemon (systemd user service)
cat > /usr/lib/systemd/user/universalbridge-daemon.service << 'EOF'
[Unit]
Description=UniversalBridge Windows Compatibility Daemon
Documentation=https://universallite.os/docs/universalbridge
After=graphical-session.target
ConditionPathExists=!/etc/universalbridge/disabled

[Service]
Type=dbus
BusName=org.universallite.UniversalBridge
ExecStart=/usr/bin/universalbridge-daemon
Restart=on-failure
RestartSec=5
MemoryLimit=50M
CPUQuota=10%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=~/.local/share/universalbridge
ReadWritePaths=~/.cache/universalbridge

[Install]
WantedBy=default.target
EOF

# UniversalBridge D-Bus Policy
mkdir -p /usr/share/dbus-1/services
cat > /usr/share/dbus-1/services/org.universallite.UniversalBridge.service << 'EOF'
[D-BUS Service]
Name=org.universallite.UniversalBridge
Exec=/usr/libexec/universalbridge-daemon
User=universalite
SystemdService=universalbridge-daemon.service
EOF

# UniversalBridge CLI Wrapper
cat > /usr/bin/universalbridge << 'EOF'
#!/bin/bash
# UniversalBridge CLI - Handle .exe/.msi files

set -euo pipefail

FILE="${1:-}"
if [[ -z "$FILE" ]]; then
    echo "Usage: universalbridge <file.exe|file.msi>"
    exit 1
fi

if [[ ! -f "$FILE" ]]; then
    echo "Error: File not found: $FILE"
    exit 1
fi

# Detect architecture and type
FILE_TYPE=$(file -b "$FILE")
echo "Detected: $FILE_TYPE"

# Determine Wine prefix and architecture
if echo "$FILE_TYPE" | grep -q "PE32"; then
    WINEARCH=win32
    WINEPREFIX="${HOME}/.local/share/universalbridge/prefixes/$(basename "$FILE" .exe)-32bit"
elif echo "$FILE_TYPE" | grep -q "PE32+"; then
    WINEARCH=win64
    WINEPREFIX="${HOME}/.local/share/universalbridge/prefixes/$(basename "$FILE" .exe)-64bit"
else
    echo "Error: Not a Windows executable"
    exit 1
fi

export WINEARCH
export WINEPREFIX
export WINEDEBUG=-all

# Create prefix if needed
if [[ ! -d "$WINEPREFIX" ]]; then
    echo "Creating Wine prefix: $WINEPREFIX"
    wineboot -u
    
    # Install common runtimes
    winetricks -q vcrun2019 corefonts dxvk 2>/dev/null || true
fi

# Run the application
echo "Launching with Wine ($WINEARCH)..."
exec wine "$FILE"
EOF
chmod +x /usr/bin/universalbridge

# MIME Type Registration
mkdir -p /usr/share/mime/packages
cat > /usr/share/mime/packages/universalbridge.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ms-dos-executable">
    <comment>Windows Executable</comment>
    <glob pattern="*.exe"/>
    <glob pattern="*.EXE"/>
    <magic priority="50">
      <match type="string" value="MZ" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-msi">
    <comment>Windows Installer</comment>
    <glob pattern="*.msi"/>
    <glob pattern="*.MSI"/>
    <magic priority="50">
      <match type="string" value="MSCF" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
EOF

# Desktop Entry for .exe/.msi
mkdir -p /usr/share/applications
cat > /usr/share/applications/universalbridge.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=UniversalBridge
Comment=Run Windows Applications
Exec=universalbridge %f
Icon=wine
Terminal=false
MimeType=application/x-ms-dos-executable;application/x-msi;
Categories=System;Emulator;
StartupNotify=true
Keywords=windows;exe;msi;wine;compatibility;
EOF

# Update MIME and Desktop databases
update-mime-database /usr/share/mime
update-desktop-database /usr/share/applications

# Compatibility Database (starter)
cat > /usr/share/universalbridge/compatdb.json << 'EOF'
{
  "version": "1.0",
  "updated": "2026-11-22",
  "applications": [
    {
      "name": "Notepad++",
      "publisher": "Don Ho",
      "version": "8.6+",
      "arch": ["win32", "win64"],
      "rating": "platinum",
      "wine_version": "9.0+",
      "runtimes": ["vcrun2019"],
      "dxvk": true,
      "notes": "Works out of the box"
    },
    {
      "name": "7-Zip",
      "publisher": "Igor Pavlov",
      "version": "24.x",
      "arch": ["win32", "win64"],
      "rating": "platinum",
      "wine_version": "9.0+",
      "runtimes": [],
      "dxvk": false,
      "notes": "Native Linux version preferred"
    },
    {
      "name": "VLC Media Player",
      "publisher": "VideoLAN",
      "version": "3.0+",
      "arch": ["win32", "win64"],
      "rating": "gold",
      "wine_version": "9.0+",
      "runtimes": ["vcrun2019"],
      "dxvk": false,
      "notes": "Native Linux version preferred"
    },
    {
      "name": "Microsoft Office 2016",
      "publisher": "Microsoft",
      "version": "16.x",
      "arch": ["win32", "win64"],
      "rating": "silver",
      "wine_version": "9.0+",
      "runtimes": ["vcrun2019", "dotnet48", "msxml6"],
      "dxvk": false,
      "notes": "Requires activation workaround, use LibreOffice instead"
    }
  ]
}
EOF

# UniversalBridge Helper Scripts
mkdir -p /usr/libexec/universalbridge

cat > /usr/libexec/universalbridge/create-prefix << 'EOF'
#!/bin/bash
# Create a new Wine prefix with common runtimes

PREFIX_NAME="${1:-default}"
ARCH="${2:-win64}"

PREFIX_DIR="${HOME}/.local/share/universalbridge/prefixes/${PREFIX_NAME}"

export WINEARCH="${ARCH}"
export WINEPREFIX="${PREFIX_DIR}"
export WINEDEBUG=-all

echo "Creating prefix: ${PREFIX_DIR} (${ARCH})"
wineboot -u

echo "Installing common runtimes..."
winetricks -q vcrun2019 corefonts dxvk 2>/dev/null || true

echo "Prefix created successfully"
EOF
chmod +x /usr/libexec/universalbridge/create-prefix

cat > /usr/libexec/universalbridge/install-runtime << 'EOF'
#!/bin/bash
# Install a runtime into an existing prefix

PREFIX_NAME="${1:-}"
RUNTIME="${2:-}"

if [[ -z "$PREFIX_NAME" || -z "$RUNTIME" ]]; then
    echo "Usage: install-runtime <prefix> <runtime>"
    echo "Runtimes: vcrun2019, dotnet48, dxvk, vkd3d, corefonts, msxml6"
    exit 1
fi

PREFIX_DIR="${HOME}/.local/share/universalbridge/prefixes/${PREFIX_NAME}"

if [[ ! -d "$PREFIX_DIR" ]]; then
    echo "Error: Prefix not found: $PREFIX_NAME"
    exit 1
fi

export WINEPREFIX="${PREFIX_DIR}"
export WINEDEBUG=-all

echo "Installing $RUNTIME into $PREFIX_NAME..."
winetricks -q "$RUNTIME" 2>/dev/null || true

echo "Done"
EOF
chmod +x /usr/libexec/universalbridge/install-runtime

# Enable universalbridge-daemon by default (socket-activated)
mkdir -p /etc/systemd/user/default.target.wants
ln -sf /usr/lib/systemd/user/universalbridge-daemon.service /etc/systemd/user/default.target.wants/universalbridge-daemon.service

echo "=== UniversalBridge installation complete ==="