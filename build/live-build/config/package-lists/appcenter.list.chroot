# Flathub Remote (added via hook)
# flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# UniversalLite Flatpak Remote (custom, added via hook)
# flatpak remote-add --if-not-exists universallite https://flatpak.universallite.os/repo.flatpakrepo

# App Center Backend (custom)
universal-appcenter-backend
universal-appcenter-frontend
universal-appcenter-cli

# PackageKit (for system updates)
packagekit
packagekit-tools
gnome-software-plugin-packagekit

# APT Integration
apt-listchanges
apt-listbugs
unattended-upgrades
apt-config-auto-update

